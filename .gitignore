# 抓取的大型第三方资源/竞品仓库，不作为本仓库源码跟踪（规则14）
# 注意：gitignore 不支持行尾注释，注释必须独占一行（否则整行被当作 pattern）
others/twopoint5d/
others/assets_raw/
others/assets_dl/
others/game_src_tree/
others/game_src/
others/local_site/
others/godot_probe/
others/clarity/
others/cultivation-world-simulator/
others/godot_carefree/
others/chrome_*/
others/*.png
others/*.js
others/*.html
others/*.json
# v2.5 背视角素材生成的临时大文件保留本地，但不纳入 git（文字溯源仍跟踪）
others/asset_v25/**/*.png
others/asset_v25/**/*.json

# Python
__pycache__/
*.pyc

# 系统
Thumbs.db
desktop.ini

# 工作区数据（重要，不删除；但非源码，不纳入 git 跟踪）
.workbuddy/

# docs 001-006：早期调研/竞品/运行说明，仅本地保留，云端仓库不保存
docs/001_*.md
docs/002_*.md
docs/003_*.md
docs/004_*.md
docs/005_*.md
docs/006_*.md

# v2.16 线上发布：发布产物副本与内部标记不入库（源码在 scripts/mvp_air_to_ground.html）
deploy_forge/
.wbapp_*.genie
# Forge OAuth 客户端凭据（含 client_id，不入库）
scripts/.forge_client.json
scripts/.forge_token.json
# CDP 自动化测试专用 Chrome profile（仅本地临时数据）
.chrome-debug-profile/
.chrome-p4/
.chrome-prof/
.chrome-prof2/
# git 历史重写前的本地备份（含旧历史，绝不入库）
.git-backup/
# 微信小游戏工程：用户未授权上 GitHub，仅本地保留
wechat-minigame/
scripts/31_build_minigame.js
scripts/32_smoke_minigame.js
# v2.23 花海飞行原作源码（第三方开源，仅本地参考，不入库）
reference/
ref_gamegems/

